{
  "name": "circle-kikaku-tools",
  "private": true,
  "version": "7.0.0-calm-workspace",
  "scripts": {
    "build:carbon": "node tools/build-carbon-assets.mjs",
    "test": "node tests/run-static-tests.js && node tests/google-route-planner-contract.mjs",
    "test:carbon": "playwright test tests/carbon-phase2a.spec.js",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "test:ui": "playwright test tests/basic-regression.spec.js tests/google-maps-loader.spec.js tests/google-route-planner.spec.js",
    "test:visual": "playwright test tests/basic-regression.spec.js",
    "test:visual:phase1": "playwright test tests/carbon-phase1-visual.spec.js",
    "test:refinement": "playwright test tests/refinement-audit.spec.js",
    "test:guard": "npm run lint:maps && npm run typecheck:maps && npm test && npm run build:app && npm run test:ui",
    "test:visual:update": "playwright test tests/visual-regression.spec.js tests/carbon-phase1-visual.spec.js --update-snapshots",
    "build:app": "node tools/build-static-app.mjs",
    "typecheck:maps": "tsc -p tsconfig.maps.json",
    "lint:maps": "node tools/lint-google-route-planner.mjs",
    "test:maps:contract": "node tests/google-route-planner-contract.mjs",
    "test:maps": "playwright test tests/google-maps-loader.spec.js tests/google-route-planner.spec.js",
    "test:maps:live": "playwright test tests/google-route-planner-live.spec.js",
    "verify:maps": "npm run lint:maps && npm run typecheck:maps && npm run test:maps:contract && npm run build:app && npm run test:maps"
  },
  "devDependencies": {
    "@carbon/icons": "11.85.0",
    "@carbon/web-components": "2.60.0",
    "@ibm/plex-sans": "1.1.0",
    "@ibm/plex-sans-jp": "3.0.0",
    "@playwright/test": "^1.61.0",
    "esbuild": "0.28.1",
    "sortablejs": "1.15.0",
    "stylelint": "^17.13.0"
  }
}
