        ".validate": "!newData.exists() || (newData.hasChildren(['schemaVersion', 'allocations', 'resetGeneration', 'lastUpdatedAt', 'lastUpdatedBy', 'revision']) && newData.child('schemaVersion').val() == 6 && newData.child('allocations').child('car').child('type').val() == 'car' && newData.child('allocations').child('team').child('type').val() == 'team' && (!newData.child('activeAllocationType').exists() || newData.child('activeAllocationType').val() == 'car' || newData.child('activeAllocationType').val() == 'team') && newData.child('resetGeneration').isNumber() && newData.child('resetGeneration').val() >= 0 && newData.child('lastUpdatedBy').isString() && (!newData.child('participants').exists() || newData.child('participants').hasChildren()) && (!newData.child('participantTombstones').exists() || newData.child('participantTombstones').hasChildren()) && (!newData.child('syncOperations').exists() || newData.child('syncOperations').hasChildren()) && (!newData.child('settlement').exists() || newData.child('settlement').hasChildren()) && (!newData.child('overview').exists() || newData.child('overview').hasChildren()) && (!newData.child('meta').exists() || newData.child('meta').hasChildren()))",
