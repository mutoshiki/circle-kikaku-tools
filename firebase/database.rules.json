          }
        },
        "participantTombstones": {
          "$participantId": {
            ".validate": "!data.exists() || newData.exists() || newData.parent().parent().child('resetGeneration').val() > data.parent().parent().child('resetGeneration').val()"
          }
        },
        "lastUpdatedAt": {
          ".validate": "newData.isNumber()"
        },
        "revision": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && (!data.exists() || newData.val() >= data.val())"
        }
      }
    },
    "projectWorkspacesV1": {
      "$roomId": {
        ".read": "auth != null && $roomId.matches(/^[A-Za-z0-9_-]{6,80}$/) && root.child('rooms').child($roomId).exists()",
        ".write": "auth != null && $roomId.matches(/^[A-Za-z0-9_-]{6,80}$/) && root.child('rooms').child($roomId).exists() && newData.exists() && (data.exists() && newData.child('schemaVersion').val() == 1 && newData.child('revision').val() == data.child('revision').val() + 1 || !data.exists() && newData.child('schemaVersion').val() == 1 && newData.child('revision').val() == 0)",
        ".validate": "!newData.exists() || (newData.hasChildren(['schemaVersion', 'tools', 'revision', 'createdAt', 'updatedAt']) && newData.child('schemaVersion').val() == 1 && (!newData.child('template').exists() || (newData.child('template').hasChildren(['id', 'version']) && newData.child('template').child('version').val() == 1)) && newData.child('tools').hasChildren() && newData.child('revision').isNumber() && newData.child('revision').val() >= 0 && newData.child('createdAt').isNumber() && newData.child('createdAt').val() > 0 && newData.child('updatedAt').isNumber() && newData.child('updatedAt').val() > 0)",
