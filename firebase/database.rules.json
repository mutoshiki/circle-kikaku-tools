            "enabled": { ".validate": "newData.isBoolean()" },
            "pinned": { ".validate": "newData.isBoolean()" },
            "$other": { ".validate": false }
          }
        },
        "tabOrder": {
          "$index": {
            ".validate": "newData.isString() && newData.val().matches(/^(application-form|submission-documents|mountain-plan|participants|car|team|settlement)$/) && newData.val() != 'tools' && newData.parent().parent().child('tools').child(newData.val()).child('pinned').val() == true"
          }
        },
