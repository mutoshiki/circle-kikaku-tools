        },
        "platform": {
          ".validate": "newData.isString() && newData.val().length <= 160"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "bugReportNotifications": {
      ".read": false,
      ".write": false
    },
    "formMakerV1": {
