              },
              "admissionSlotId": {
                ".validate": "newData.isString() && newData.val().matches(/^(0[1-9]|[1-3][0-9]|40)$/)"
              },
              "input": {
                ".validate": "newData.hasChildren(['projectId', 'tokenHash', 'responseKeys', 'manualParticipantHashes'])",
                "projectId": {
                  ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_-]{6,80}$/)"
                },
                "tokenHash": {
                  ".validate": "newData.isString() && newData.val().matches(/^[a-f0-9]{64}$/)"
                },
                "responseKeys": {
                  ".validate": "newData.isString() && newData.val().length <= 8599 && (newData.val().length == 0 || newData.val().matches(/^r_[A-Za-z0-9_-]{12,40}(,r_[A-Za-z0-9_-]{12,40})*$/))"
                },
                "manualParticipantHashes": {
                  ".validate": "newData.isString() && newData.val().length <= 12999 && (newData.val().length == 0 || newData.val().matches(/^[a-f0-9]{64}(,[a-f0-9]{64})*$/))"
                },
                "$other": {
                  ".validate": false
                }
              },
              "requestedAt": {
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "state": {
                ".write": "auth != null && root.child('formMakerV1/workers').child(auth.uid).val() == true && newData.exists() && ((data.val() == 'queued' && (newData.val() == 'running' || newData.val() == 'failed')) || (data.val() == 'running' && (newData.val() == 'completed' || newData.val() == 'failed' || newData.val() == 'unknown')))",
                ".validate": "newData.val() == 'queued' || newData.val() == 'running' || newData.val() == 'completed' || newData.val() == 'failed' || newData.val() == 'unknown'"
              },
              "updatedAt": {
                ".write": "auth != null && root.child('formMakerV1/workers').child(auth.uid).val() == true && (data.parent().child('state').val() == 'queued' || data.parent().child('state').val() == 'running') && newData.exists()",
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "startedAt": {
                ".write": "auth != null && root.child('formMakerV1/workers').child(auth.uid).val() == true && data.parent().child('state').val() == 'queued' && newData.exists()",
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "finishedAt": {
                ".write": "auth != null && root.child('formMakerV1/workers').child(auth.uid).val() == true && data.parent().child('state').val() == 'running' && newData.exists()",
                ".validate": "newData.isNumber() && newData.val() > 0"
              },
              "result": {
                ".write": "auth != null && root.child('formMakerV1/workers').child(auth.uid).val() == true && data.parent().child('state').val() == 'running' && newData.exists()",
                "fileId": {
                  ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200"
                },
                "downloadUrl": {
                  ".validate": "newData.isString() && newData.val().matches(/^https:\\/\\/drive\\.google\\.com\\//) && newData.val().length <= 2048"
                },
                "expiresAt": {
                  ".validate": "newData.isNumber() && newData.val() > 0"
                },
                "count": {
                  ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 200"
                },
                "$other": {
                  ".validate": false
                }
              },
              "errorCode": {
                ".write": "auth != null && root.child('formMakerV1/workers').child(auth.uid).val() == true && (data.parent().child('state').val() == 'queued' || data.parent().child('state').val() == 'running') && newData.exists()",
                ".validate": "newData.isString() && newData.val().length <= 80"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "testOwners": {
        ".read": "auth != null && root.child('formMakerV1/workers').child(auth.uid).val() == true",
        ".write": "auth != null && root.child('formMakerV1/workers').child(auth.uid).val() == true",
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || root.child('formMakerV1/workers').child(auth.uid).val() == true)",
          ".validate": "newData.val() == true"
        }
      }
    }
  }
}
