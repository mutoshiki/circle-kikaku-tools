        ".write": "auth != null && !data.exists() && newData.exists()",
        ".validate": "newData.hasChildren(['message', 'createdAt', 'roomId', 'pageUrl', 'buildId', 'projectTitle', 'currentView', 'userAgent', 'platform'])",
