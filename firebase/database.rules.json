        "requestedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "expiresAt": { ".validate": "newData.isNumber() && newData.val() > newData.parent().child('requestedAt').val() && newData.val() <= newData.parent().child('requestedAt').val() + 21600000" },
        "startedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
        "completedAt": { ".validate": "newData.isNumber() && newData.val() > 0" },
